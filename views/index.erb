<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Storage</title>
  <link rel="stylesheet" href="<%= request.script_name %>/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <script>window.APP_BASE_PATH = "<%= request.script_name %>";</script>
  <div class="container">
    <header class="header">
      <h1><i class="fas fa-hdd"></i> Storage</h1>
      <div class="header-controls">
        <span class="muted">Last updated: <span id="last-update">never</span></span>
        <button id="refresh-btn" class="btn"><i class="fas fa-sync-alt"></i> Refresh</button>
      </div>
    </header>
    <div class="notice"><i class="fas fa-flask"></i> Showing toy data. Not real quota values.</div>
    <div id="error" class="error hidden"></div>
    <div id="cards" class="cards"></div>
  </div>
  <script src="<%= request.script_name %>/script.js"></script>
</body>
</html>
